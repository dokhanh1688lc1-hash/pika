# ===== Supabase (Postgres + Auth) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (webhook Telegram, AI Agent). KHÔNG đặt NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# (Tuỳ chọn) cửa hàng dùng cho chat trong TELEGRAM_ALLOWED_CHAT_IDS khi chưa liên kết nhân viên
DEFAULT_STORE_ID=

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=
# Chuỗi ngẫu nhiên dài; Telegram gửi kèm header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# (Tuỳ chọn, dùng khi chưa có DB) danh sách chat id được phép, cách nhau bằng dấu phẩy
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== AI Agent =====
ANTHROPIC_API_KEY=
# Miễn phí: dùng Gemini thay cho Anthropic (khoá ở https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Để trống: app tự chọn model flash mới nhất còn hoạt động
GEMINI_MODEL=
# Hoặc dịch vụ tương thích OpenAI (Groq, OpenRouter...): khoá, địa chỉ API và tên model
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_COMPAT_MODEL=
AI_MODEL=claude-sonnet-5-5

# ===== Cảnh báo hạn sử dụng =====
# Chuỗi ngẫu nhiên dài; Vercel Cron gửi kèm khi gọi /api/cron/expiry hằng ngày (08:00 giờ VN)
CRON_SECRET=
# Số ngày báo trước khi hết hạn (mặc định 30)
EXPIRY_ALERT_DAYS=30

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
